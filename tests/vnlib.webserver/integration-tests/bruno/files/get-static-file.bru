meta {
  name: get-static-file
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/hello.html
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("serves the fixture content as html", function() {
    expect(res.body).to.include("CI-HELLO-FILE");
    expect(res.headers['content-type']).to.include('text/html');
  });
}
