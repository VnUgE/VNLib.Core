meta {
  name: get-hello
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/test/hello
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns hello result", function() {
    expect(res.body.result).to.equal("hello");
    expect(res.body.success).to.equal(true);
  });
}
